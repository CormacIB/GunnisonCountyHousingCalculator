# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Published CSV export URL for the Listings tab (tab 1).
# Format: https://docs.google.com/spreadsheets/d/e/<ID>/pub?gid=<GID>&single=true&output=csv
# In Google Sheets: File → Share → Publish to web → select Listings tab → CSV → Publish.
# The URL from "pubhtml" won't work — make sure it ends with output=csv.
LISTINGS_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_ID/pub?gid=0&single=true&output=csv

# Published CSV export URL for the AMI Table tab (tab 2).
# Repeat above steps for the AMI Table tab. The gid value will differ.
# To find a tab's gid: click the tab → check the URL — it ends in #gid=XXXXXX
AMI_TABLE_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_ID/pub?gid=XXXXXX&single=true&output=csv
