# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Published CSV export URL for the Listings tab (tab 1).
# In Google Sheets: File → Share → Publish to web → select the Listings tab → CSV → Publish.
# Paste the generated URL here.
LISTINGS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Published CSV export URL for the AMI Table tab (tab 2).
# Repeat the above steps for the AMI Table tab. The gid value will differ from tab 1.
# To find a tab's gid: click the tab in Google Sheets and check the URL — it ends in #gid=XXXXXX
AMI_TABLE_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=XXXXXX
